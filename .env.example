# --- Telegram bots (from @BotFather) ---
LEADS_BOT_TOKEN=123456:ABC-leads-token
SUPPORT_BOT_TOKEN=123456:ABC-support-token

# --- Chat IDs (negative for groups/supergroups) ---
LEADS_CHAT_ID=-1001234567890
SUPPORT_CHAT_ID=-1001234567890
# Forum (topics) supergroup gives each support ticket its own thread for the relay.
SUPPORT_FORUM=true

# --- OUR ops Postgres (NOT Lovable's). A Supabase project you own, or Render PG. ---
# Stores lead/ticket state + claim status. Lovable Cloud's DB is unreachable, so we
# keep our own. Use the "session" pooler / direct connection string.
DATABASE_URL=postgresql://postgres:[password]@db.<ref>.supabase.co:5432/postgres

# --- Public URL of this service (Render) — used to register Telegram webhooks ---
PUBLIC_BASE_URL=https://turkarta-operations.onrender.com

# --- Shared secrets ---
# Sent by the Lovable form / edge function as header  X-Webhook-Secret
LEADS_WEBHOOK_SECRET=change-me-lead-ingest
# Path + header secret for Telegram webhooks
TELEGRAM_WEBHOOK_SECRET=change-me-telegram

# --- Roster: who gets @-mentioned + who can claim ---
# JSON array. tg_id optional but lets the bot mention people without a @username.
ROSTER=[{"name":"Artem","username":"artem_tk","tg_id":111111111}]

PORT=8000

# --- Анализ поддержки: off, shadow или assist (внутренние задачи) ---
SUPPORT_AI_MODE=off
# OPENAI_API_KEY=...
# Отдельный секрет минимум 32 символа; только для руководителя/внутреннего сервиса.
# SUPPORT_AI_ADMIN_SECRET=...
SUPPORT_AI_MODEL=gpt-5.4-nano
SUPPORT_AI_DAILY_USD=1
SUPPORT_AI_MONTHLY_USD=20
SUPPORT_AI_TICKET_DAILY_CALLS=12
# Один источник: API опубликованных статей или проверенный JSON-экспорт.
# SUPPORT_AI_KB_API=https://your-api.example/api/knowledge-base
# SUPPORT_AI_KB_FILE=/absolute/path/to/knowledge_base_seed.json

# Необязательно: отдельный read-only endpoint в Turkarta API (нужна новая версия API).
# Указать origin нужной среды, без пути. Секрет — отдельный, минимум 32 символа.
# SUPPORT_AI_DIAGNOSTICS_URL=https://your-api.example
# SUPPORT_AI_DIAGNOSTICS_SECRET=...
# На стороне Turkarta API тот же ключ называется SUPPORT_DIAGNOSTICS_SECRET.

# Для assist нужны ОТДЕЛЬНЫЕ внутренние группы, отличные от SUPPORT_CHAT_ID/LEADS_CHAT_ID.
# Группа QA — только для руководителей, отдельно от группы задач.
# SUPPORT_AI_INTERNAL_CHAT_ID=-1000000000001
# SUPPORT_AI_QA_CHAT_ID=-1000000000002
# Telegram ID основного и резервного ответственного. support — обязательный fallback.
# SUPPORT_AI_OWNER_ROUTES={"support":{"primary_tg":111,"backup_tg":222},"payments":{"primary_tg":333,"backup_tg":444},"kyc":{"primary_tg":555,"backup_tg":666},"engineering":{"primary_tg":777,"backup_tg":888}}
SUPPORT_AI_ACK_MINUTES=10
SUPPORT_AI_UPDATE_MINUTES=60
SUPPORT_AI_MAX_REMINDERS=3
# Сводка за предыдущий календарный день UTC; 04:00 UTC = 09:00 в Алматы.
SUPPORT_AI_DIGEST_HOUR_UTC=4
# Full relay is the default. The isolated dev entrypoint uses sandbox instead.
SUPPORT_RUNTIME=relay
